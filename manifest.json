{
  "manifest_version": 3,
  "name": "Cloudy",
  "version": "0.1.0",
  "description": "Chat with a local Ollama model from the Chrome side panel.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel"],
  "host_permissions": ["http://localhost:11434/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Cloudy",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
